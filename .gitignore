# Dependencies
node_modules/

# Build outputs
dist/
packages/daemon-standalone/public/
.wrangler/
# daemon-core's tsup outDir is dist/, so any .d.ts/.js under src/ is a stray
# build artifact, not source. Hand-authored ambient declarations (this repo's
# convention: vite-env.d.ts in Vite packages) are not needed here — daemon-core
# has no `declare global`/`declare module` file today — but if one is ever
# added, name it *.ambient.d.ts to keep it out of this pattern.
packages/daemon-core/src/**/*.d.ts
!packages/daemon-core/src/**/*.ambient.d.ts
packages/daemon-core/src/**/*.js

# Environment
.env
.env.local
.env.*
.dev.vars
wrangler.toml

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# TypeScript build cache
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# VS Code Extension package
*.vsix

# Wrangler local state
.wrangler/

# npm pack artifacts
*.tgz

# OSS repo local clone
adhdev-oss/

# Turbo / Coverage
.turbo/
coverage/

# Debug / temp files
*.patch
codex_*
debug_*
ide_dom.json
.aider*
.adhdev-dev-pids.json

# Local agent tool state (machine-specific, must not be tracked)
.antigravitycli/
