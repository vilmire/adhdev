// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AssistantStagedWrites > shows driver access, risk and the OS advisory, and approves only its Inbox id 1`] = `"<div class="font-medium" data-driver-access-advisory="true">Declared access · not enforced at OS level</div><dl class="break-words"><div><dt class="inline font-medium">Name: </dt><dd class="inline">Computer Use Driver</dd></div><div><dt class="inline font-medium">Publisher: </dt><dd class="inline">ADHDev</dd></div><div><dt class="inline font-medium">Version: </dt><dd class="inline">1.2.3</dd></div><div><dt class="inline font-medium">Trust: </dt><dd class="inline">external-js</dd></div><div><dt class="inline font-medium">Tree digest: </dt><dd class="inline">sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa</dd></div><div><dt class="inline font-medium">Command and arguments: </dt><dd class="inline">["node","server.js"]</dd></div><div><dt class="inline font-medium">Risk class: </dt><dd class="inline">Elevated</dd></div><div><dt class="inline font-medium">Network: </dt><dd class="inline">["example.com"]</dd></div><div><dt class="inline font-medium">Filesystem: </dt><dd class="inline">["/tmp"]</dd></div><div><dt class="inline font-medium">Desktop control: </dt><dd class="inline">true</dd></div></dl><ul class="list-inside list-disc"><li>Desktop control is declared</li><li>Filesystem access outside workspace: /tmp</li></ul>"`;
