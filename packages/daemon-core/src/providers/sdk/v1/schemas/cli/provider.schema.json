{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.adhf.dev/schemas/v1/cli/provider.schema.json",
  "title": "CLI provider.json — v1",
  "description": "Schema for CLI provider manifests. Validates the contract documented in docs/provider-contract/cli/v1.md. All 4 production CLI providers (codex, claude, hermes, antigravity) pass this schema without modification.",
  "type": "object",
  "required": [
    "type",
    "name",
    "category",
    "binary",
    "spawn"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema URL — optional, lets editors validate the file. Conventionally https://registry.adhf.dev/schemas/v1/cli/provider.schema.json."
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Stable identifier. Lowercase kebab-case."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Short canonical name."
    },
    "displayName": {
      "type": "string",
      "description": "Optional UI label. Defaults to name."
    },
    "category": {
      "const": "cli",
      "description": "Must be \"cli\" for this schema."
    },
    "icon": {
      "type": "string",
      "maxLength": 4,
      "description": "Single emoji or short glyph."
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Alternative identifiers accepted at launch."
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adhdev": {
          "type": "string",
          "description": "SemVer range against the ADHDev contract version. Required for marketplace-published providers."
        }
      },
      "description": "Optional today; required by marketplace publish flow once registry is live."
    },
    "providerVersion": {
      "type": "string",
      "description": "Provider package SemVer."
    },
    "contractVersion": {
      "type": [
        "number",
        "string"
      ],
      "description": "Legacy contract version. Reserved."
    },
    "status": {
      "enum": [
        "Stable",
        "Beta",
        "Experimental",
        "Deprecated"
      ]
    },
    "details": {
      "type": "string",
      "description": "Short blurb shown in marketplace."
    },
    "links": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "format": "uri"
      },
      "description": "External links shown in the marketplace detail view. Known keys are documented; additional URI-valued keys are allowed.",
      "properties": {
        "homepage": {
          "type": "string",
          "format": "uri",
          "description": "Provider home page."
        },
        "repo": {
          "type": "string",
          "format": "uri",
          "description": "Source repository (typically GitHub)."
        },
        "docs": {
          "type": "string",
          "format": "uri",
          "description": "Documentation root."
        },
        "install": {
          "type": "string",
          "format": "uri",
          "description": "Install guide page."
        },
        "issues": {
          "type": "string",
          "format": "uri",
          "description": "Issue tracker."
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Install hints displayed in the marketplace. Known keys (npm/pip/homebrew/curl/manual) carry per-manager CLI commands; additional string keys are allowed for new channels.",
      "properties": {
        "homebrew": {
          "type": "string",
          "description": "Homebrew install command, e.g. \"brew install foo\"."
        },
        "npm": {
          "type": "string",
          "description": "npm install command, e.g. \"npm i -g foo\"."
        },
        "pip": {
          "type": "string",
          "description": "pip install command."
        },
        "curl": {
          "type": "string",
          "description": "curl/wget install one-liner."
        },
        "manual": {
          "type": "string",
          "description": "Free-form install note when no package manager applies."
        }
      }
    },
    "disableUpstream": {
      "type": "boolean",
      "description": "When true, daemon does not auto-sync this provider from registry. claude-cli uses this for explicit-version pinning."
    },
    "binary": {
      "type": "string",
      "minLength": 1,
      "description": "Binary basename used for which-style detection."
    },
    "versionCommand": {
      "type": "string",
      "description": "Command the daemon runs to probe installed version. Example: \"my-cli --version\"."
    },
    "spawn": {
      "type": "object",
      "required": [
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "shell": {
          "type": "boolean",
          "default": false
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      }
    },
    "autoApproveModes": {
      "type": "object",
      "description": "Provider-specific auto-approve choices and their launch/runtime strategy.",
      "required": [
        "default",
        "modes"
      ],
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "string",
          "minLength": 1
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/autoApproveMode"
          }
        }
      }
    },
    "modelLaunchArgs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Template for expanding an initialModel selection into launch args. '{{model}}' is substituted with the model string (e.g. ['--model', '{{model}}'] → --model opus). Applied at launch when a model is requested for this CLI provider (MAGI kind-panel model axis). Absent → no launch-time model selection."
    },
    "modelOptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Suggested model values shown as dropdown options in the new-session dialog (brain-routing model axis), e.g. ['opus','sonnet','haiku']. Advisory — the UI still accepts free text, so a stale list never blocks an accepted model."
    },
    "thinkingLaunchArgs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Template for expanding an initialThinkingLevel selection into launch args (brain-routing thinking axis, parallel to modelLaunchArgs). '{{level}}' is substituted with the provider-mapped reasoning-effort value (e.g. ['--effort', '{{level}}'] → --effort high; ['-c', 'model_reasoning_effort={{level}}']). Applied at launch when a thinking level is requested. Absent → no launch-time thinking selection."
    },
    "thinkingLevelMap": {
      "type": "object",
      "properties": {
        "low": {
          "type": "string"
        },
        "medium": {
          "type": "string"
        },
        "high": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Optional map from the standard thinking levels (low/medium/high) to this provider's own reasoning-effort vocabulary, used to fill {{level}} in thinkingLaunchArgs. A level absent from the map passes through unchanged."
    },
    "thinkingLevelOptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Reasoning-effort values this provider accepts, shown as the thinking-level dropdown in the new-session dialog (e.g. ['low','medium','high','max']). Absent → the UI falls back to standard low/medium/high. Provider's own vocabulary, passed through verbatim."
    },
    "thinkingControlId": {
      "type": "string",
      "description": "For a provider with no thinkingLaunchArgs but a runtime reasoning-effort control (e.g. hermes 'reasoning'), the controls[].id to drive at launch for the thinking level. The control's setScript is invoked with { value: <mapped level> }."
    },
    "sendDelayMs": {
      "type": "number",
      "minimum": 0,
      "description": "Delay between pasting prompt text and pressing Enter."
    },
    "scriptCallBudgetMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000,
      "default": 50,
      "description": "Per-invocation wall-clock budget (ms) for provider scripts (detectStatus, parseSession, parseApproval). Default 50. Scripts that exceed the budget are flagged in the runner's invocation trace and surfaced via the debug bundle so operators can identify a hanging settle loop. The budget is NOT a hard kill — Node CJS cannot interrupt synchronous code without a worker thread."
    },
    "sendKey": {
      "type": "string",
      "default": "\r",
      "description": "Character sent to submit a prompt. Default carriage return."
    },
    "submitStrategy": {
      "enum": [
        "wait_for_echo",
        "immediate"
      ],
      "default": "immediate"
    },
    "requirePromptEchoBeforeSubmit": {
      "type": "boolean",
      "default": false,
      "description": "When true, daemon waits for the typed prompt to be visible in the PTY screen before sending sendKey."
    },
    "allowInputDuringGeneration": {
      "type": "boolean",
      "default": false,
      "description": "When true, daemon permits sending a new prompt mid-generation."
    },
    "requiresFinalAssistantBeforeIdle": {
      "type": "boolean",
      "default": false,
      "description": "When true, daemon defers generating→idle until parseSession includes a final standard assistant message. Also selects the completion-timing floor for a native-source provider: an idle without a final assistant reply is treated as a possible mid-tool-call quiet valley, so the decoupled CANON-C completion is held under the min-elapsed floor (noExternalTranscriptSource) rather than emitted immediately. A provider that leaves this false is a write-lag native source (e.g. claude-cli) whose transcript merely trails the finished idle by a write, so it emits immediately."
    },
    "holdCompletionForTranscript": {
      "type": "boolean",
      "default": false,
      "description": "Completion-timing authority for a native-history provider whose live idle verdict is PTY-derived but whose authoritative answer lands in native history (e.g. antigravity-cli). When true, an idle-without-final-assistant HOLDS for the native transcript to land (holdForTranscript) instead of emitting or applying the min-elapsed floor, and the hold persists past the 30s finalization cap while the PTY is still active (bounded by the hard cap). This is the third completion-timing class alongside immediate (requiresFinalAssistantBeforeIdle=false) and floor (requiresFinalAssistantBeforeIdle=true)."
    },
    "augmentStaleSnapshot": {
      "type": "boolean",
      "description": "Reserved for future use."
    },
    "transcriptAuthority": {
      "enum": [
        "provider",
        "daemon"
      ],
      "description": "When 'provider', daemon treats parsed output as canonical and suppresses fallback parsing."
    },
    "transcriptContext": {
      "enum": [
        "full",
        "tail"
      ],
      "description": "When 'full', provider-owned parser receives the entire accumulated transcript context."
    },
    "patterns": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional regex hints for the legacy fallback detector. Modern providers express these via primitives.",
      "properties": {
        "prompt": {
          "$ref": "#/$defs/patternList"
        },
        "generating": {
          "$ref": "#/$defs/patternList"
        },
        "approval": {
          "$ref": "#/$defs/patternList"
        },
        "ready": {
          "$ref": "#/$defs/patternList"
        },
        "dialog": {
          "$ref": "#/$defs/patternList"
        }
      }
    },
    "approvalKeys": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Map of button index → key sequence to send."
    },
    "approvalPositiveHints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lowercase substrings considered \"positive\" (accept). Auto-approve picks the matching button."
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ptyFlush": {
          "type": "number",
          "minimum": 0
        },
        "dialogAccept": {
          "type": "number",
          "minimum": 0
        },
        "approvalCooldown": {
          "type": "number",
          "minimum": 0
        },
        "generatingIdle": {
          "type": "number",
          "minimum": 0
        },
        "idleFinish": {
          "type": "number",
          "minimum": 0
        },
        "idleFinishConfirm": {
          "type": "number",
          "minimum": 0
        },
        "statusActivityHold": {
          "type": "number",
          "minimum": 0
        },
        "maxResponse": {
          "type": "number",
          "minimum": 0
        },
        "shutdownGrace": {
          "type": "number",
          "minimum": 0
        },
        "outputSettle": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported"
      ],
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "stopStrategy": {
          "enum": [
            "command",
            "ctrl_c",
            "signal"
          ]
        },
        "stopCommand": {
          "type": "string"
        },
        "shutdownGraceMs": {
          "type": "number",
          "minimum": 0
        },
        "sessionIdFormat": {
          "enum": [
            "uuid",
            "free",
            "string"
          ]
        },
        "newSessionArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resumeSessionArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resumeArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "compatibility": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ideVersion"
        ],
        "additionalProperties": false,
        "properties": {
          "ideVersion": {
            "type": "string",
            "description": "SemVer range."
          },
          "scriptDir": {
            "type": "string",
            "pattern": "^scripts/[^/]+$"
          },
          "spec": {
            "type": "string",
            "pattern": "^specs/[^/]+\\.json$",
            "description": "Path to declarative spec.json driving SpecCliAdapter for this version range."
          }
        }
      },
      "description": "Maps installed agent versions to script subdirectories and/or declarative specs."
    },
    "defaultScriptDir": {
      "type": "string",
      "pattern": "^scripts/[^/]+$",
      "description": "Fallback when no compatibility[] entry matches."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional code source pointer. When present, the daemon fetches script files (the `defaultScriptDir` + any `compatibility[].scriptDir`) from this GitHub repository on install so extended-tier providers can ship without bundling all bytes into the manifest. Verified / declarative-only providers can omit this entirely.",
      "properties": {
        "type": {
          "const": "github",
          "description": "Currently only `github` is supported."
        },
        "repo": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+$",
          "description": "GitHub repo as `owner/name`."
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Branch, tag, or — strongly recommended — a 40-char commit SHA so the package is reproducible."
        },
        "subdir": {
          "type": "string",
          "description": "Optional subdirectory inside the repo that contains this provider's tree (e.g. \"cli/claude-cli\"). When omitted the daemon uses `{category}/{type}` (current adhdev-providers layout)."
        }
      },
      "required": [
        "type",
        "repo",
        "ref"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "multipart": {
              "type": "boolean"
            },
            "mediaTypes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "strategies": {
              "type": "array"
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "richContent": {
              "type": "boolean"
            },
            "mediaTypes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "controls": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "typedResults": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "meshCoordinator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported"
      ],
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "mcpConfig": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "manual",
                "auto_import"
              ]
            },
            "format": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "configPathCommand": {
              "type": "string"
            },
            "serverName": {
              "type": "string"
            },
            "requiresRestart": {
              "type": "boolean"
            },
            "instructions": {
              "type": "string"
            },
            "template": {
              "type": "string"
            }
          }
        },
        "systemPromptInjection": {
          "description": "How the coordinator system prompt reaches the launched CLI. Replaces hard-coded router branches per CLI type; users may override the prompt body or the injection mechanism here.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "flag"
              ],
              "properties": {
                "mode": {
                  "const": "cli_arg"
                },
                "flag": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "flag",
                "template"
              ],
              "properties": {
                "mode": {
                  "const": "config_override"
                },
                "flag": {
                  "type": "string"
                },
                "template": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "path"
              ],
              "properties": {
                "mode": {
                  "const": "context_file"
                },
                "path": {
                  "type": "string"
                },
                "wrapper": {
                  "type": "string"
                },
                "owned": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "name"
              ],
              "properties": {
                "mode": {
                  "const": "env_var"
                },
                "name": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "flag"
              ],
              "properties": {
                "mode": {
                  "const": "agent_file"
                },
                "flag": {
                  "type": "string"
                },
                "template": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "launchArgs": {
          "description": "Extra spawn args appended ONLY for coordinator launches (e.g. cursor-agent's --approve-mcps accepts the daemon-written .cursor/mcp.json without parking on the MCP-approval modal).",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "delegatedWorkerIsolation": {
          "description": "Provider-declared launch isolation for coordinator-spawned worker sessions. Keeps worker-only sessions from inheriting coordinator MCP/tools/config.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "env": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "unset": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "set": {
                  "description": "Environment variables set to a concrete value for delegated worker sessions. Distinct from `unset` (which clears). Values may use the {{workerHome}} placeholder, expanded to the worker-private HOME the daemon prepares for the launch. `unset` wins on conflict.",
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "args": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "mode",
                      "flag"
                    ],
                    "properties": {
                      "mode": {
                        "const": "empty_mcp_config"
                      },
                      "flag": {
                        "type": "string",
                        "minLength": 1
                      },
                      "strictFlag": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "mode",
                      "flag",
                      "key",
                      "value"
                    ],
                    "properties": {
                      "mode": {
                        "const": "config_override"
                      },
                      "flag": {
                        "type": "string",
                        "minLength": 1
                      },
                      "key": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      },
                      "dedupeKey": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "canonicalHistory": {
      "type": "object",
      "description": "Deprecated v0 alias for `nativeHistory`. The loader copies this block into `nativeHistory` at load time. New manifests should use `nativeHistory` directly.",
      "additionalProperties": true,
      "properties": {
        "format": {
          "type": "string"
        },
        "watchPath": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "native-source",
            "materialized-mirror",
            "disabled",
            "daemon-mirror"
          ]
        },
        "contractVersion": {
          "type": "string"
        },
        "scripts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "readSession": {
              "type": "string"
            },
            "listSessions": {
              "type": "string"
            }
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/settingDef"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/controlDef"
      }
    },
    "tui": {
      "type": "object",
      "description": "Declarative TUI parsing primitives. When present, daemon's builder synthesises detectStatus / parseApproval / parseSession from these blocks. Each block is identified by its $schema.",
      "additionalProperties": true
    },
    "nativeHistory": {
      "type": "object",
      "description": "Native transcript adapter declaration. v1 canonical field name. Daemon reads/lists provider-native history files via the named scripts (or the built-in adapter identified by $schema).",
      "additionalProperties": true,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "watchPath": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "native-source",
            "materialized-mirror",
            "disabled",
            "daemon-mirror"
          ]
        },
        "contractVersion": {
          "type": "string"
        },
        "scripts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "readSession": {
              "type": "string"
            },
            "listSessions": {
              "type": "string"
            }
          }
        }
      }
    },
    "overrides": {
      "type": "object",
      "description": "Optional JS override pointers. Presence promotes the provider tier to `extended`. Each value identifies the handler being overridden and the relative path to the JS file implementing it.",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "description": "Relative path to the override JS file."
          },
          {
            "type": "object",
            "required": [
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "$schema": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "autoApproveMode": {
      "type": "object",
      "required": [
        "id",
        "label",
        "strategy",
        "risk"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "enum": [
            "pty-parse-default",
            "launch-args",
            "post-boot-command"
          ]
        },
        "risk": {
          "enum": [
            "safe",
            "caution",
            "dangerous"
          ]
        },
        "warning": {
          "type": "string",
          "minLength": 1
        },
        "launchArgs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "removeArgs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "launch-args"
              }
            },
            "required": [
              "strategy"
            ]
          },
          "then": {
            "required": [
              "launchArgs"
            ],
            "properties": {
              "launchArgs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "risk": {
                "const": "dangerous"
              }
            },
            "required": [
              "risk"
            ]
          },
          "then": {
            "required": [
              "warning"
            ]
          }
        }
      ]
    },
    "patternList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "description": "Regex source."
          },
          "flags": {
            "type": "string",
            "pattern": "^[gimsuy]*$"
          }
        }
      }
    },
    "settingDef": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "boolean",
            "number",
            "string",
            "select"
          ]
        },
        "default": {},
        "public": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "options": {
          "type": "array"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ]
          }
        }
      ]
    },
    "controlDef": {
      "type": "object",
      "required": [
        "id",
        "type",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "select",
            "action",
            "toggle"
          ]
        },
        "label": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "placement": {
          "type": "string"
        },
        "order": {
          "type": "number"
        },
        "dynamic": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean",
          "description": "When true, dashboard does not render the control directly. Used for commands triggered by other UI (slash menu, etc.)."
        },
        "options": {
          "type": "array"
        },
        "listScript": {
          "type": "string"
        },
        "setScript": {
          "type": "string"
        },
        "invokeScript": {
          "type": "string"
        },
        "readFrom": {
          "type": "string"
        },
        "resultDisplay": {
          "type": "string"
        },
        "defaultValue": {},
        "confirmTitle": {
          "type": "string"
        },
        "confirmMessage": {
          "type": "string"
        },
        "confirmLabel": {
          "type": "string"
        }
      }
    }
  }
}
